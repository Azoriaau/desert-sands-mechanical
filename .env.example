# Lead endpoint the contact form POSTs to (Formspree URL or Azoria CRM ingest
# URL). Leave unset to fall back to a mailto: composer.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Cloudflare Turnstile site key. Only rendered when a contact endpoint is also
# configured; the endpoint must verify the token server-side (siteverify).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
